# Copy this file to `.env` if you want to override local defaults.
PORT=3000
# NODE_ENV=production

# Local JSON is the default primary data source.
DB_SOURCE=json
# JSON_DB_PATH=./src/database/data.json

# Optional Neon/Postgres access.
# Set DB_SOURCE=neon to make this the primary source for /test-db.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
