# Copy this file to `.env` if you want to override local defaults.
PORT=3000
# NODE_ENV=production

# Local JSON is the default primary data source.
DB_SOURCE=json
# JSON_DB_PATH=./src/database/data.json

# Optional Neon/Postgres access.
# Set DB_SOURCE=neon to make this the primary source for /test-db.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: enables Gemini wording for detected alerts. Detection and severity
# still work without this key and use deterministic safe-language messages.
# GEMINI_API_KEY=your-google-ai-api-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=8000
